uation_facts":[{"fact":"UTKFace target images use 13 corruption types at severity 5. Predict age; R2 is higher-better and may be negative.","id":"E1","source_locator":"S4.SS1 and S4.T4"},{"fact":"Source is the unadapted comparator. Oracle has target-label access and is not a same-information competitor.","id":"E2","source_locator":"S4.SS2"},{"fact":"The supplied cells are rounded author-reported aggregate values, not independent experimental repetitions.","id":"E3","source_locator":"S4.T4; input construction boundary"}],"method_facts":[{"fact":"A source-trained feature extractor feeds a fixed linear regression head w.T z + b.","id":"M1","source_locator":"S3.SS2"},{"fact":"Source feature covariance supplies leading eigenvectors V and positive eigenvalues lambda; project centered features as V(z-mu_source).","id":"M2","source_locator":"S3.SS2"},{"fact":"Per-axis target batch means and variances are aligned to source moments (0, lambda) with a weighted symmetric Gaussian KL objective; alpha_d = 1 + abs(w.T v_d).","id":"M3","source_locator":"S3.SS2"},{"fact":"Source data are unavailable during target adaptation; source statistics were obtained beforehand. Target labels are not adaptation inputs.","id":"M4","source_locator":"S3.SS1 and S3.SS2"},{"fact":"Adaptation updates only the feature extractor's normalization affine scale and shift parameters (gamma, beta); other model parameters, including the regression head, remain fixed.","id":"M5","source_locator":"S3.SS2 immediately after Eq.8"}],"scope":"Regression test-time adaptation; the numeric evidence supplied here concerns corrupted UTKFace age prediction only.","unknown_or_excluded":["Per-run observations and sampling uncertainty are not supplied.","No supplied compute measurements, independent reproduction or test of causality.","No full algorithm implementation or claim of licensed reuse of the author's proprietary repository.","No other dataset table is included; do not import inconsistent summaries from elsewhere."]}},"instruction":"Complete this WRITE_CONTENT task using only the supplied inputs. No tool calls, file reads or internet needed. Return passage and claim-to-source map in the requested JSON.","role":"research_executor","task_view":{"asset_manifest":[{"asset_id":"numeric-evidence","path":"assets/public/numeric_evidence.json","sha256":"af7d547a7ccce1a9349d2343750bfd1baf1c1dcf0404702edf15af135815c429"},{"asset_id":"research-facts","path":"assets/public/research_facts.json","sha256":"d983f2115ff183deda8f159a289b6a7c34cb47f9c73fc53c4db83f521cd2030e"}],"inputs":["numeric-evidence","research-facts"],"output_contract":{"claim_source_map":"Associate central technical/numeric statements with fact IDs or cell IDs. Mark missing facts as unknown; no need to mimic source prose.","required":["research_passage","claim_source_map"]},"prompt":"Write a coherent, technically faithful methods-and-findings passage (approximately 350–550 words) for the scoped study using only the supplied research facts and numeric evidence. Explain the fixed approach, its information boundaries, the supported comparison and limitations. Select an appropriate organization; do not discover new claims or invent missing details. Cite source fact/cell IDs through an accompanying claim-to-source map. No figure, whole-paper PDF or new experiment is required.","public_rubric":{"checks":["Check narrative claims and technical semantics, including pseudocode when requested.","A faithful statement of unknown details is preferable to invented reproducibility or ethics information.","No requirement to recreate original wording, section order, visual layout or complete paper PDF.","Use cited support, not superficial textual similarity to the source paper."],"dimensions":{"completeness":["Most requested scientific content is absent or key conditions required to understand it are omitted.","Covers the requested contribution, relevant method/assumptions/evidence and necessary qualifications within scope/length, explicitly marking missing source facts."],"comprehensibility":["Contradictory or disorganized exposition prevents understanding of the core argument.","A coherent, technically understandable argument distinguishes motivation, method, evidence and scope; formal elegance or verbosity is not a substitute."],"fidelity":["Central method, attribution, numeric result or conclusion contradicts the supplied authoritative material.","Technical content, claims, comparisons and limitations faithfully express the supplied evidence without inventing implementation, approval, findings or certainty."],"traceability":["Central claims and citations cannot be connected to the provided research materials.","Relevant claims, methods, attribution and reproducibility statements can be traced to exact supplied assets/locations with no fabricated provenance."]},"levels":{"0":"Absent or fundamentally invalid for this dimension; identify the actual affected requirement, not merely a style dislike.","1":"Some relevant work, but major defects leave most core requirements unsupported.","2":"Partially sound and useful, with material gaps or limitations affecting central requirements.","3":"Sound on the core requirements; limited, localized weaknesses or explicitly bounded uncertainty remain.","4":"Strong, evidence-supported fulfillment within the task scope; no material unresolved deficiency. Not perfection or positive results by definition."},"purpose":"Evaluate accurate coherent research exposition from fixed scientific facts; do not demand new experiments or discoveries.","required_evidence_roles":["task","submission","reference"],"task_type":"WRITE_CONTENT","version":"development-0.1"},"release_mode":"development_not_formal_acceptance","resources":{"budget_status":"candidate_development_cap_not_formal","data_access":"fixed public assets only","development_wall_time_seconds":600,"gpu_allowed":false,"network":"disabled"},"task_id":"dev-write-content-001","task_type":"WRITE_CONTENT","tools":["model_cli