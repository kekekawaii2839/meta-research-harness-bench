+# --- mrhbench patch: faithful OpenAI mode (WRAPPER_FAITHFUL_API=1); registered first so it takes precedence ---
+from src import faithful_api
+if faithful_api.ENABLED:
+    @app.post("/v1/chat/completions")
+    async def faithful_chat_completions(request: Request, credentials: Optional[HTTPAuthorizationCredentials] = Depends(security)):
