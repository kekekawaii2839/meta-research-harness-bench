+        try:
+            body = await request.json()
+        except Exception:
+            return JSONResponse(status_code=400, content={"error": {"message": "invalid JSON body", "type": "invalid_request_error", "code": "invalid_json"}})
+        return await faithful_api.chat_completion(body)
+# --- end mrhbench patch ---
