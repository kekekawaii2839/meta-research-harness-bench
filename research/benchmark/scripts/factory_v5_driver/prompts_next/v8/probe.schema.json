{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_type", "predicted_contribution", "key_ingredients", "predicted_findings",
               "steering_passages", "specificity", "recognised_paper"],
  "properties": {
    "schema_version": {"const": "v8-probe-1"},
    "task_type": {"enum": ["LIT", "IDEA"]},
    "predicted_contribution": {"type": "string", "minLength": 20},
    "key_ingredients": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
    "predicted_findings": {"type": "string"},
    "steering_passages": {
      "type": "array", "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false, "required": ["quote", "location"],
                "properties": {"quote": {"type": "string", "minLength": 3, "maxLength": 300},
                               "location": {"type": "string"}}}
    },
    "specificity": {"enum": ["generic", "directional", "specific"]},
    "recognised_paper": {"type": "boolean"},
    "recognised_note": {"type": "string"}
  }
}
