{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit", "cutoff_date", "research_question", "files", "deliverables", "public_facts"],
  "properties": {
    "schema_version": {"const": "v8-frame-1"},
    "unit": {"enum": ["LIT", "IDEA"]},
    "cutoff_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "research_question": {"type": "string", "minLength": 20},
    "files": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "role"],
                "properties": {"path": {"type": "string", "pattern": "^assets/[A-Za-z0-9_./-]+$"},
                               "role": {"enum": ["task_statement", "background_report", "output_schema", "checker", "other"]},
                               "description": {"type": "string"}}}
    },
    "deliverables": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "format"],
                "properties": {"path": {"type": "string"}, "format": {"type": "string"}}}
    },
    "public_facts": {
      "type": "array", "minItems": 2, "maxItems": 12,
      "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "statement", "kind"],
                "properties": {"fact_id": {"type": "string", "pattern": "^PF-[0-9]{2}$"},
                               "statement": {"type": "string", "minLength": 5},
                               "kind": {"enum": ["maintainer_scope", "source_fact"]}}}
    },
    "notes": {"type": "string"}
  }
}
